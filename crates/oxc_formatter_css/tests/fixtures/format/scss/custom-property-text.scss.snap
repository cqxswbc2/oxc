// verbatim (sass-spec css/custom_properties/simple.hrx).
.simple {
  --url: url(http://foo.com/bar);
  --single-line: // (
    );
  --typed: 1px + 2px;
}

// Values that merely contain `//` keep the typed parse and its normalization
// (a trailing `//` note stays a comment, a protocol-relative url is a url).
.typed {
  --n: url(//cdn/a.png) red;
  --s: red; // note
  --z: "a//b" "c";
}

